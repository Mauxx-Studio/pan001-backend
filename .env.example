# Copia este archivo a .env y ajusta los valores para tu entorno local:
#   cp .env.example .env

# Puerto en el que escucha la API (por defecto 8080)
PORT=8080

# Entorno de ejecución: development | staging | production
# En development GORM loguea todas las consultas SQL.
APP_ENV=development

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=mauri
DB_PASSWORD=uqbar212
DB_NAME=miapp
DB_SSLMODE=disable

# --- JWT ---
# Clave HMAC con la que se firman los access tokens (vigencia: 24 h).
# En desarrollo, si no se define se usa "dev-secret-cambiar-en-produccion".
# En producción es obligatoria: config.Load falla si APP_ENV=production y falta.
JWT_SECRET=dev-secret-cambiar-en-produccion
